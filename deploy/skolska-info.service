# systemd servis: Skolska Informacija na drugom uređaju (Linux).
# Server se sam podize posle butovanja i restartuje ako se srusi.
#
# Instalacija (terminal, kao root ili sa sudo ispred svake komande):
#   1. Promeni ispod putanju u WorkingDirectory i User na svoje ime.
#      Primer: WorkingDirectory=/home/mug208/school-information
#               User=mug208
#   2. Ako je Node instaliran preko nvm, promeni ExecStart u punu putanju:
#      izvrsi:  which node   i nalepi tu putanju.
#   3. sudo cp deploy/skolska-info.service /etc/systemd/system/
#   4. sudo systemctl daemon-reload
#   5. sudo systemctl enable --now skolska-info
#
# Korisne komande:
#   systemctl status skolska-info     stanje servisa
#   journalctl -u skolska-info -f     pracenje loga u zivo
#   sudo systemctl restart skolska-info

[Unit]
Description=Skolska Informacija: server za login i sinhronizaciju
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# PROMENI OVE DVE LINIJE na svoju putanju i svoje korisnicko ime.
WorkingDirectory=/home/korisnik/school-information
User=korisnik
Group=korisnik

# Pun putanja do node izvrsnog fajla (koji node).
ExecStart=/usr/bin/node server/server.js

Environment=PORT=8080
Environment=HOST=0.0.0.0

# Ako proces padne, systemd ga podize posle 5 sekundi.
Restart=always
RestartSec=5

# Logovi idu u journald (vidi journalctl -u skolska-info).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=skolska-info

# Umerena zastita procesa.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
